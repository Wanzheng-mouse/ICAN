# Backend test environment (M2, 2026-07-26)
# Used by pytest / CI for an isolated, non-destructive configuration.
# The conftest.py overrides ICAN_DATABASE_URL with a throwaway temp DB,
# so the DB value below is only a documented default for manual runs.
# Deliberately contains NO real secrets — only test placeholders.

# ---- 数据库 ----
ICAN_DATABASE_URL=sqlite:///./.test-ci.db

# ---- CORS（测试用最小白名单） ----
ICAN_CORS_ORIGINS=http://localhost:3000

# ---- 上传 ----
ICAN_UPLOAD_DIR=./uploads
ICAN_MAX_UPLOAD_BYTES=10485760

# ---- 安全：测试环境不回传重置令牌 ----
ICAN_EXPOSE_RESET_TOKEN=false

# ---- 日志（测试降低噪音） ----
ICAN_LOG_LEVEL=WARNING

# ---- Agnes LLM（仅测试占位，真实值放 .env，勿提交） ----
ICAN_AGNES_API_KEY=test-key
ICAN_AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
ICAN_LLM_MODEL=agnes-2.0-flash
