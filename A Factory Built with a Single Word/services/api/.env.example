# ---- 数据库 ----
ICAN_DATABASE_URL=sqlite:///./ican.db
# ---- CORS（前端 Origin，逗号分隔） ----
ICAN_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
# ---- 上传 ----
ICAN_UPLOAD_DIR=./uploads
ICAN_MAX_UPLOAD_BYTES=10485760
# ---- 安全：是否向前端回传重置令牌（生产务必 false） ----
ICAN_EXPOSE_RESET_TOKEN=false
# ---- 日志 ----
ICAN_LOG_LEVEL=INFO
# ---- Agnes LLM（占位，真实值放 .env，勿提交） ----
ICAN_AGNES_API_KEY=your-agnes-api-key
ICAN_AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
ICAN_LLM_MODEL=agnes-2.0-flash
ICAN_AGNES_REQUEST_TIMEOUT_SECONDS=300
ICAN_LLM_MAX_TOKENS=8192
# ---- Seed user credentials (development/demo only) ----
# Seed users are only created on a fresh database; setting ICAN_SEED_ENABLED=false
# in production disables the demo accounts entirely.  Passwords must be changed
# on first login in any non-development environment.
ICAN_SEED_ENABLED=true
ICAN_SEED_ADMIN_LOGIN=admin
ICAN_SEED_DEMO_LOGIN=lisi
ICAN_SEED_ADMIN_PASSWORD=ChangeMe-OnFirstLogin!
ICAN_SEED_DEMO_PASSWORD=ChangeMe-OnFirstLogin!
